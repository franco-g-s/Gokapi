{{define "collection"}}{{template "header" .}}

<div class="container-fluid download-wrapper p-4">
    <div class="file-card card">
{{ if .IsPasswordView }}
        <div class="card-body p-5 text-center">
            <h3 class="card-title mb-3">{{ .Collection.Name }}</h3>
            <p class="text-muted">This collection is password protected.</p>
            {{ if .IsFailedLogin }}
            <div class="alert alert-danger py-2">Incorrect password</div>
            {{ end }}
            <form method="post" action="./c?id={{ .Collection.Id }}" class="mt-3">
                <input type="password" name="password" class="form-control mb-3"
                       placeholder="Password" autofocus required>
                <button type="submit" class="btn btn-light w-100">Unlock</button>
            </form>
        </div>
{{ else }}
        <div class="card-body p-4">

            <div class="text-center mb-4">
                <h3 class="card-title mb-1">{{ .Collection.Name }}</h3>
                <p class="text-muted mb-0">
                    {{ .FileCount }} file{{ if ne .FileCount 1 }}s{{ end }} &middot; {{ .TotalSize }}
                    {{ if not .NeverExpires }} &middot; available until {{ .ExpiryString }}{{ end }}
                </p>
            </div>

            <div class="d-flex justify-content-end mb-2" data-fgs-layout-toggle data-layout-default="list">
                <div class="btn-group" role="group" aria-label="Layout">
                    <button type="button" class="btn btn-sm btn-outline-light" data-layout="board">Board</button>
                    <button type="button" class="btn btn-sm btn-light" data-layout="list">List</button>
                </div>
            </div>
            <div class="fgs-board d-none" id="fgs-board">
                {{ range .Items }}
                <figure class="fgs-board-item" data-id="{{ .File.Id }}" data-name="{{ .File.Name }}"
                        data-download="{{ .Preview.Download }}" data-view="{{ .Preview.View }}" data-video="{{ .Preview.Video }}"
                        data-taken="{{ .Preview.TakenAt }}" data-uploaded="{{ .File.UploadDate }}" data-size="{{ .File.Size }}"
                        data-w="{{ .Preview.Width }}" data-h="{{ .Preview.Height }}" style="background:{{ .Preview.Color }}">
                    {{ if .Preview.Thumb }}<img data-src="{{ .Preview.Thumb }}" alt="" decoding="async">
                    {{ if .Preview.Video }}<span class="fgs-play"><i class="bi bi-play-fill"></i></span>{{ end }}
                    {{ else }}<span class="fgs-typeicon"><i class="bi bi-file-earmark"></i><small>{{ .File.Name }}</small></span>{{ end }}
                </figure>
                {{ end }}
            </div>

            <div class="table-responsive" id="fgs-collection-list">
                <table class="table table-dark align-middle" id="collectiontable">
                    <thead>
                        <tr>
                            <th scope="col">Filename</th>
                            <th scope="col">Size</th>
                            <th scope="col" class="text-end">Download</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{ range $i, $item := .Items }}
                        {{ with $item.File }}
                        <tr>
                            <td class="collection-filename"><button type="button" class="btn btn-link p-0 text-start fgs-open-viewer" data-index="{{ $i }}">{{ .Name }}</button></td>
                            <td>{{ .Size }}</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-light"
                                   href="./cd?id={{ $.Collection.Id }}&amp;file={{ .Id }}"
                                   data-fileid="{{ .Id }}"
                                   data-filename="{{ .Name }}">
                                    <i class="bi bi-download"></i>
                                </a>
                            </td>
                        </tr>
                        {{ end }}
                        {{ end }}
                    </tbody>
                </table>
            </div>

            {{ template "media_download_buttons" .Buttons }}
            {{ template "media_help_sheet" }}
            {{ template "media_viewer" }}

        </div>
{{ end }}
    </div>
</div>

<script>
// Download all: each file in turn, via the shared FGS.downloadSequentially
(function () {
    var button = document.getElementById("downloadAllButton");
    var status = document.getElementById("downloadAllStatus");
    if (!button || !status) return;
    var links = Array.prototype.slice.call(
        document.querySelectorAll("#collectiontable a[data-fileid]"));
    if (!links.length) { button.style.display = "none"; return; }

    button.addEventListener("click", function () {
        FGS.downloadSequentially(links.map(function (source) {
            return { url: source.getAttribute("href"), name: source.getAttribute("data-filename") || "" };
        }), { button: button, status: status });
    });
})();
</script>

<script>
FGS.initDownloadButtons(document.querySelector("[data-fgs-downloads]"));
(function () {
    var board = document.getElementById("fgs-board");
    if (!board) return;
    FGS.initLayoutToggle(document.querySelector("[data-fgs-layout-toggle]"),
        board, document.getElementById("fgs-collection-list"), "collectionLayout");
    // Filename in the list opens the viewer at that row. The board's tiles carry the item data.
    document.getElementById("fgs-collection-list").addEventListener("click", function (e) {
        var b = e.target.closest(".fgs-open-viewer");
        if (!b) return;
        var tiles = Array.prototype.slice.call(board.querySelectorAll(".fgs-board-item"));
        FGS.openViewer(tiles.map(function (t) { return FGS.itemFromEl(t); }), parseInt(b.getAttribute("data-index"), 10) || 0);
    });
})();
</script>

{{ template "pagename" "PublicCollection"}}
{{ template "customjs" .}}

{{template "footer"}}
{{end}}
