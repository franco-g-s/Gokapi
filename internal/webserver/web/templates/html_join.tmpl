{{ define "group_join" }}{{ template "header" . }}
<div class="row"><div class="col"><div id="container" class="card" style="max-width:32em;margin:0 auto">
<div class="card-body">
  {{ if .Message }}
    <h3 class="card-title mb-3">{{ .Message }}</h3>
    <a class="btn btn-outline-light" href="./groups">Groups</a>
  {{ else }}
    <h3 class="card-title mb-3">Join <em>{{ .GroupName }}</em>?</h3>
    <p class="text-muted">{{ .People }} {{ if eq .People 1 }}person{{ else }}people{{ end }} · {{ .Closes }}</p>
    <form method="post" action="./groups/join">
      <input type="hidden" name="t" value="{{ .Token }}">
      <button type="submit" class="btn btn-light">Join</button>
    </form>
  {{ end }}
</div></div></div></div>

<script src="./js/min/admin.min.{{ template "js_admin_version"}}.js"></script>
{{ template "pagename" "Join group"}}
{{ template "customjs" .}}
{{ template "footer" true}}{{ end }}
