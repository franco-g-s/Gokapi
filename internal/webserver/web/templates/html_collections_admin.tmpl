{{define "collections_admin"}}{{template "header" .}}

<div class="row">
  <div class="col">
    <div id="container" class="card" style="width: 80%">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <h3 class="card-title mb-0">Collections</h3>
          <button id="newCollectionButton" class="btn btn-sm btn-light" type="button"
                  title="New collection">
            <i class="bi bi-plus-lg"></i>
          </button>
        </div>
        <br>
        <p class="card-text">

        {{ if not .Collections }}
          <p class="text-muted text-center my-4">
            No collections yet. Tick some files on the Upload page and choose
            &ldquo;Create one link&rdquo; to share several files with a single URL.
          </p>
        {{ else }}
          <div class="table-responsive">
            <table id="collectionstable" class="table table-dark">
              <thead>
                <tr>
                  <th scope="col">Name</th>
                  <th scope="col">Files</th>
                  <th scope="col">Size</th>
                  <th scope="col">Created</th>
                  <th scope="col">Available until</th>
                  <th scope="col">Actions</th>
                </tr>
              </thead>
              <tbody>
                {{ range .Collections }}
                <tr id="collection-{{ .Id }}">
                  <td>
                    {{ .Name }}
                    {{ if not .IsOwn }}<span class="badge bg-secondary ms-2">{{ .OwnerName }}</span>{{ end }}
                  </td>
                  <td>{{ .FileCount }}</td>
                  <td>{{ .TotalSize }}</td>
                  <td>{{ .Created }}</td>
                  <td>{{ if .NeverExpires }}Unlimited{{ else }}{{ .Expiry }}{{ end }}</td>
                  <td>
                    <button class="btn btn-sm btn-outline-light collection-files"
                            type="button" data-id="{{ .Id }}" title="Show files">
                      <i class="bi bi-list-ul"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-light collection-rename"
                            type="button" data-id="{{ .Id }}" data-name="{{ .Name }}" title="Rename">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-light collection-copy"
                            type="button" data-url="{{ .Url }}" title="Copy link">
                      <i class="bi bi-clipboard"></i> Copy link
                    </button>
                    <a class="btn btn-sm btn-outline-light" href="{{ .Url }}"
                       target="_blank" rel="noopener" title="Open">
                      <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                    <button class="btn btn-sm btn-outline-danger collection-delete"
                            type="button" data-id="{{ .Id }}" data-name="{{ .Name }}" title="Delete">
                      <i class="bi bi-trash3"></i>
                    </button>
                  </td>
                </tr>
                <tr class="collection-files-row" id="files-{{ .Id }}" style="display:none">
                  <td colspan="6">
                    <ul class="collection-member-list" data-collection="{{ .Id }}">
                      {{ range .Files }}
                      <li data-fileid="{{ .Id }}">
                        <span class="member-name">{{ .Name }}</span>
                        <span class="member-size">{{ .Size }}</span>
                        <button class="btn btn-sm btn-outline-danger member-remove"
                                type="button" title="Remove from collection">
                          <i class="bi bi-x-lg"></i>
                        </button>
                      </li>
                      {{ end }}
                    </ul>
                    <button class="btn btn-sm btn-outline-light mt-2 collection-addfiles"
                            type="button" data-id="{{ .Id }}" data-name="{{ .Name }}">
                      <i class="bi bi-plus-lg"></i> Add files
                    </button>
                  </td>
                </tr>
                {{ end }}
              </tbody>
            </table>
          </div>
          <p class="text-muted small mt-3 mb-0">
            A collection is a view over its files: it stays available for as long as at
            least one file in it is, and deleting it never deletes the files.
          </p>
        {{ end }}

        </p>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="filePickerModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="filePickerTitle">Choose files</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                aria-label="Close"></button>
      </div>
      <div class="modal-body">
        {{ if not .Items }}
          <p class="text-muted mb-0">
            You have no files yet. <a href="./admin">Upload some first</a>, then come back.
          </p>
        {{ else }}
          <input type="text" id="filePickerFilter" class="form-control mb-3"
                 placeholder="Filter by filename">
          <ul class="file-picker-list">
            {{ range .Items }}
            <li data-name="{{ .Name }}">
              <label>
                <input class="form-check-input file-picker-check" type="checkbox" value="{{ .Id }}">
                <span class="picker-name">{{ .Name }}</span>
                <span class="picker-size">{{ .Size }}</span>
              </label>
            </li>
            {{ end }}
          </ul>
        {{ end }}
      </div>
      <div class="modal-footer justify-content-between">
        <a href="./admin" class="text-muted small">Need to upload something first?</a>
        <div>
          <span id="filePickerCount" class="text-muted small me-2"></span>
          <button type="button" class="btn btn-light" id="filePickerConfirm" disabled>Confirm</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.querySelectorAll(".collection-copy").forEach(function (button) {
    button.addEventListener("click", function () {
        navigator.clipboard.writeText(button.getAttribute("data-url")).then(function () {
            var original = button.innerHTML;
            button.textContent = "Copied";
            window.setTimeout(function () { button.innerHTML = original; }, 1500);
        });
    });
});
function postCollection(url, payload) {
    return fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify(payload)
    }).then(function (r) { return r.json(); });
}

document.querySelectorAll(".collection-files").forEach(function (button) {
    button.addEventListener("click", function () {
        var row = document.getElementById("files-" + button.getAttribute("data-id"));
        if (row) row.style.display = row.style.display === "none" ? "" : "none";
    });
});

document.querySelectorAll(".collection-rename").forEach(function (button) {
    button.addEventListener("click", function () {
        var id = button.getAttribute("data-id");
        var name = window.prompt("New name:", button.getAttribute("data-name"));
        if (name === null || name.trim() === "") return;
        postCollection("./collections/modify", { id: id, name: name.trim() })
            .then(function (data) {
                if (data.Result !== "OK") {
                    window.alert("Could not rename: " + (data.ErrorMessage || "unknown error"));
                    return;
                }
                window.location.reload();
            });
    });
});

document.querySelectorAll(".member-remove").forEach(function (button) {
    button.addEventListener("click", function () {
        var item = button.closest("li");
        var list = button.closest(".collection-member-list");
        var remaining = Array.prototype.slice
            .call(list.querySelectorAll("li"))
            .filter(function (li) { return li !== item; })
            .map(function (li) { return li.getAttribute("data-fileid"); });
        if (remaining.length === 0) {
            window.alert("A collection needs at least one file.\n\nDelete the collection instead.");
            return;
        }
        button.disabled = true;
        postCollection("./collections/modify",
                       { id: list.getAttribute("data-collection"), fileIds: remaining })
            .then(function (data) {
                if (data.Result !== "OK") {
                    window.alert("Could not remove: " + (data.ErrorMessage || "unknown error"));
                    button.disabled = false;
                    return;
                }
                window.location.reload();
            });
    });
});

// --- file picker: shared by "new collection" and "add files" ---------------
(function () {
    var modalEl = document.getElementById("filePickerModal");
    if (!modalEl) return;
    var modal = new bootstrap.Modal(modalEl);
    var title = document.getElementById("filePickerTitle");
    var confirm = document.getElementById("filePickerConfirm");
    var counter = document.getElementById("filePickerCount");
    var filter = document.getElementById("filePickerFilter");
    var boxes = Array.prototype.slice.call(document.querySelectorAll(".file-picker-check"));
    var mode = null;          // "create" | "add"
    var targetId = null;

    function selectedIds() {
        return boxes.filter(function (b) { return b.checked; }).map(function (b) { return b.value; });
    }
    function refresh() {
        var n = selectedIds().length;
        confirm.disabled = n === 0;
        counter.textContent = n === 0 ? "" : n + " selected";
    }
    boxes.forEach(function (b) { b.addEventListener("change", refresh); });

    if (filter) {
        filter.addEventListener("input", function () {
            var needle = filter.value.toLowerCase();
            document.querySelectorAll(".file-picker-list li").forEach(function (li) {
                var name = (li.getAttribute("data-name") || "").toLowerCase();
                li.style.display = name.indexOf(needle) === -1 ? "none" : "";
            });
        });
    }

    function open(newMode, id, label) {
        mode = newMode;
        targetId = id;
        boxes.forEach(function (b) { b.checked = false; });
        if (filter) { filter.value = ""; filter.dispatchEvent(new Event("input")); }
        title.textContent = newMode === "create" ? "New collection" : "Add files to " + label;
        refresh();
        modal.show();
    }

    var newButton = document.getElementById("newCollectionButton");
    if (newButton) {
        newButton.addEventListener("click", function () { open("create", null, ""); });
    }
    document.querySelectorAll(".collection-addfiles").forEach(function (button) {
        button.addEventListener("click", function () {
            open("add", button.getAttribute("data-id"), button.getAttribute("data-name"));
        });
    });

    confirm.addEventListener("click", function () {
        var ids = selectedIds();
        if (!ids.length) return;
        confirm.disabled = true;

        if (mode === "add") {
            postCollection("./collections/modify", { id: targetId, addFileIds: ids })
                .then(function (data) {
                    if (data.Result !== "OK") {
                        window.alert("Could not add: " + (data.ErrorMessage || "unknown error"));
                        confirm.disabled = false;
                        return;
                    }
                    window.location.reload();
                });
            return;
        }

        var name = window.prompt("Name for this collection:", "Shared files");
        if (name === null) { confirm.disabled = false; return; }
        var password = window.prompt(
            "Password for this collection?\n\nLeave blank for no password.", "");
        if (password === null) { confirm.disabled = false; return; }
        postCollection("./collections/create",
                       { name: name, fileIds: ids, password: password.trim() })
            .then(function (data) {
                if (data.Result !== "OK") {
                    window.alert("Could not create: " + (data.ErrorMessage || "unknown error"));
                    confirm.disabled = false;
                    return;
                }
                window.location.reload();
            });
    });
})();

document.querySelectorAll(".collection-delete").forEach(function (button) {
    button.addEventListener("click", function () {
        var id = button.getAttribute("data-id");
        if (!window.confirm("Delete the collection \"" + button.getAttribute("data-name") +
                            "\"?\n\nThe files themselves are kept.")) {
            return;
        }
        button.disabled = true;
        fetch("./collections/delete?id=" + encodeURIComponent(id), {
            method: "POST", credentials: "same-origin"
        }).then(function (r) { return r.json(); }).then(function (data) {
            if (data.Result !== "OK") {
                window.alert("Could not delete: " + (data.ErrorMessage || "unknown error"));
                button.disabled = false;
                return;
            }
            var row = document.getElementById("collection-" + id);
            if (row) row.remove();
        }).catch(function (e) {
            window.alert("Could not delete: " + e);
            button.disabled = false;
        });
    });
});
</script>

{{ template "pagename" "Collections"}}
{{ template "customjs" .}}

{{template "footer" true}}
{{end}}
