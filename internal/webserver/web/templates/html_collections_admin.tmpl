{{define "collections_admin"}}{{template "header" .}}

<div class="row">
  <div class="col">
    <div id="container" class="card" style="width: 80%">
      <div class="card-body">
        <div class="position-relative">
          <h3 class="card-title">Collections</h3>
          <button id="newCollectionButton" class="btn btn-sm btn-light" type="button"
                  title="New collection">
            <i class="bi bi-plus-lg"></i>
          </button>
        </div>
        <br>
        <p class="card-text">

        {{ if not .Collections }}
          <p class="text-muted text-center my-4">
            No collections yet. Tick some files on the Upload page and choose
            &ldquo;Create one link&rdquo; to share several files with a single URL.
          </p>
        {{ else }}
          <div class="table-responsive">
            <table id="collectionstable" class="table table-dark">
              <thead>
                <tr>
                  <th scope="col">Name</th>
                  <th scope="col">Files</th>
                  <th scope="col">Size</th>
                  <th scope="col">Created</th>
                  <th scope="col">Available until</th>
                  <th scope="col">Actions</th>
                </tr>
              </thead>
              <tbody>
                {{ range .Collections }}
                <tr id="collection-{{ .Id }}">
                  <td>
                    {{ if .HasPassword }}<i class="bi bi-lock-fill me-1" title="Password protected"></i>{{ end }}
                    <a class="collection-name-link" href="./c?id={{ .Id }}">{{ .Name }}</a>
                    {{ if not .IsOwn }}<span class="badge bg-secondary ms-2">{{ .OwnerName }}</span>{{ end }}
                  </td>
                  <td data-col-count>{{ .FileCount }}</td>
                  <td data-col-size>{{ .TotalSize }}</td>
                  <td>{{ .Created }}</td>
                  <td data-col-expiry>{{ if .NeverExpires }}Unlimited{{ else }}{{ .Expiry }}{{ end }}</td>
                  <td>
                    <button class="btn btn-sm btn-outline-light collection-files"
                            type="button" data-id="{{ .Id }}" title="Show files">
                      <i class="bi bi-list-ul"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-light collection-password"
                            type="button" data-id="{{ .Id }}" data-name="{{ .Name }}"
                            data-haspassword="{{ .HasPassword }}" title="Set or change password">
                      <i class="bi bi-key"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-light collection-rename"
                            type="button" data-id="{{ .Id }}" data-name="{{ .Name }}" title="Rename">
                      <i class="bi bi-pencil"></i>
                    </button>
                    {{ if or .IsOwn $.ActiveUser.IsAdmin }}
                    <button class="btn btn-sm btn-outline-light collection-togroup"
                            type="button" data-id="{{ .Id }}" data-name="{{ .Name }}" title="Turn into a group">
                      <i class="bi bi-people"></i>
                    </button>
                    {{ end }}
                    <button class="btn btn-sm btn-outline-light collection-copy"
                            type="button" data-url="{{ .Url }}" title="Copy link">
                      <i class="bi bi-clipboard"></i> Copy link
                    </button>
                    <a class="btn btn-sm btn-outline-light" href="{{ .Url }}"
                       target="_blank" rel="noopener" title="Open">
                      <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                    <button class="btn btn-sm btn-outline-danger collection-delete"
                            type="button" data-id="{{ .Id }}" data-name="{{ .Name }}" title="Delete">
                      <i class="bi bi-trash3"></i>
                    </button>
                  </td>
                </tr>
                <tr class="collection-files-row" id="files-{{ .Id }}" style="display:none">
                  <td colspan="6">
                    {{ template "file_browser" .Browser }}
                    <button class="btn btn-sm btn-outline-light mt-2 collection-addfiles"
                            type="button" data-id="{{ .Id }}" data-name="{{ .Name }}">
                      <i class="bi bi-plus-lg"></i> Add files
                    </button>
                  </td>
                </tr>
                {{ end }}
              </tbody>
            </table>
          </div>
          <p class="text-muted small mt-3 mb-0">
            A collection is a view over its files: it stays available for as long as at
            least one file in it is, and deleting it never deletes the files.
          </p>
        {{ end }}

        </p>

        {{ if .SharedWithMe }}
          <h2 class="h5 mt-4">Shared with me</h2>
          <div class="table-responsive">
            <table id="sharedwithmetable" class="table table-dark">
              <thead>
                <tr>
                  <th scope="col">Name</th>
                  <th scope="col">From</th>
                  <th scope="col">Files</th>
                  <th scope="col">Size</th>
                  <th scope="col">First opened</th>
                </tr>
              </thead>
              <tbody>
                {{ range .SharedWithMe }}
                <tr id="shared-{{ .Id }}">
                  <td><a class="collection-name-link" href="./c?id={{ .Id }}">{{ .Name }}</a></td>
                  <td>{{ .OwnerName }}</td>
                  <td>{{ .FileCount }}</td>
                  <td>{{ .TotalSize }}</td>
                  <td>{{ .FirstOpened }}</td>
                </tr>
                {{ end }}
              </tbody>
            </table>
          </div>
        {{ end }}
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="filePickerModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="filePickerTitle">Choose files</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div id="filePickerMeta" class="mb-3" style="display:none">
          <input type="text" id="filePickerName" class="form-control mb-2"
                 placeholder="Collection name" value="Shared files">
          <div class="d-flex gap-2">
            <input type="text" id="filePickerPassword" class="form-control"
                   placeholder="Password (optional)">
            <button type="button" class="btn btn-outline-light text-nowrap"
                    id="filePickerSuggest">Suggest</button>
          </div>
        </div>
        {{ if not .Items }}
          <p class="text-muted mb-0">
            You have no files yet. <a href="./admin">Upload some first</a>, then come back.
          </p>
        {{ else }}
          <input type="text" id="filePickerFilter" class="form-control mb-3"
                 placeholder="Filter by filename">
          <ul class="file-picker-list">
            {{ range .Items }}
            <li data-name="{{ .Name }}">
              <label>
                <input class="form-check-input file-picker-check" type="checkbox" value="{{ .Id }}">
                <span class="picker-name">{{ .Name }}</span>
                <span class="picker-size">{{ .Size }}</span>
              </label>
            </li>
            {{ end }}
          </ul>
        {{ end }}
      </div>
      <div class="modal-footer justify-content-between">
        <a href="./admin" class="text-muted small">Need to upload something first?</a>
        <div>
          <span id="filePickerCount" class="text-muted small me-2"></span>
          <button type="button" class="btn btn-light" id="filePickerConfirm" disabled>Confirm</button>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="togroup-modal" tabindex="-1" aria-labelledby="togroup-title" aria-hidden="true">
  <div class="modal-dialog gokapi-dialog">
    <div class="modal-content gokapi-dialog text-start">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="togroup-title">Turn into a group</h1>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p id="togroup-what"></p>
        <p class="text-muted small">
          The collection&rsquo;s password does not carry over: people join the group by signing in.
        </p>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="togroup-days" id="togroup-days-30" value="30">
          <label class="form-check-label" for="togroup-days-30">30 days</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="togroup-days" id="togroup-days-60" value="60" checked>
          <label class="form-check-label" for="togroup-days-60">60 days (suggested)</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="togroup-days" id="togroup-days-90" value="90">
          <label class="form-check-label" for="togroup-days-90">90 days</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="togroup-days" id="togroup-days-0" value="0">
          <label class="form-check-label" for="togroup-days-0">Never</label>
        </div>
        <div id="togroup-status" aria-live="polite"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-light" id="togroup-confirm">Turn into a group</button>
      </div>
    </div>
  </div>
</div>

