{{ define "viewas" }}
{{ template "header" . }}
<div class="row">
    <div class="col">
        <div id="container" class="card" style="width: 80%">
            <div class="card-body">
                <h3 class="card-title mb-4">View the site as…</h3>
                <p class="text-white-50">Every page shows what this person sees. Nothing can be changed or downloaded until you exit.</p>
                {{ if .People }}
                <div class="table-responsive">
                    <table class="table table-dark">
                        <tbody>
{{ range .People }}
                            <tr>
                                <td class="text-start">{{ .Name }}</td>
                                <td class="text-end"><button type="button" class="btn btn-outline-light btn-sm" data-fgs-viewas-user="{{ .Id }}">View as…</button></td>
                            </tr>
{{ end }}
                        </tbody>
                    </table>
                </div>
                {{ else }}
                <p>There is nobody to view the site as yet.</p>
                {{ end }}
            </div>
        </div>
    </div>
</div>
<script src="./js/min/admin.min.{{ template "js_admin_version"}}.js"></script>
{{ template "pagename" "ViewAs"}}
{{ template "customjs" .}}
{{ template "footer" true }}
{{ end }}
