{{ define "admin" }}{{ template "header" . }}
 
      <div class="row">
        <div class="col">
		<div id="container" class="card" style="width: 80%">
		  <div class="card-body">
		    <h3 class="card-title">Upload</h3>
		    <br>
		    <p class="card-text">
		    
			<form action="./uploadChunk" class="dropzone upload-box text-center w-100" id="uploaddropzone">
				<div class="dz-message">
{{ if .EndToEndEncryption }}
				    <p id="uploadBoxTitle" class="mb-2 fs-5">Please wait</p>
				    <p id="uploadBoxSubtitle" class="mb-0 opacity-75">Loading end-to-end encryption...</p>
{{ else }}
				    <p id="uploadBoxTitle" class="mb-2 fs-5">Drag & drop files here</p>
				    <p id="uploadBoxSubtitle" class="mb-0 opacity-75">or paste or click to select.</p>
{{ end }}
				</div>
			</form>
		
		<div id="fgs-upload-options-area">
		<div class="d-flex flex-wrap align-items-center column-gap-4 row-gap-2 mt-3">
		<div id="fgs-upload-target-wrap" hidden>
		  <div class="d-inline-flex align-items-center gap-2">
		    <label for="fgs-upload-target" class="small text-muted text-nowrap">Upload to</label>
		    <select id="fgs-upload-target" class="form-select form-select-sm w-auto" autocomplete="off"{{ if .EndToEndEncryption }} data-e2e="true"{{ end }}>
		      <option value="">My files</option>
		    </select>
		  </div>
		</div>
		<div class="form-check form-switch d-inline-flex align-items-center gap-2 mb-0 fgs-combine-option">
		  <input class="form-check-input" type="checkbox" role="switch"
		         id="enableAutoCollection" onchange="saveAutoLinkDefault()"
		         aria-label="Combine each upload into one link">
		  <label class="form-check-label small text-muted" for="enableAutoCollection">
		    Combine each upload into one link
		  </label>
		</div>
		</div>
		<p id="fgs-upload-target-note" class="small text-muted mt-2 mb-0" hidden>Files uploaded to a group stay until the group closes and can be downloaded by its members.</p>
		<div id="autoCollectionResult"></div>

		<div id="uploadstatus" class="container uploads-container">
		</div>		
		<p></p>
		
		<br>
		<div class="upload-options-grid">


		  <div class="upload-option-card">
		    <div class="upload-option-header">
		      <div class="d-flex align-items-center gap-2">
		        <i class="bi bi-calendar-x upload-option-icon"></i>
		        <span class="upload-option-label">Expiry</span>
		      </div>
		      <div class="form-check form-switch mb-0">
		        <input class="form-check-input upload-option-toggle" type="checkbox" role="switch"
		               name="enableTimeLimit" id="enableTimeLimit"
		               onchange="checkBoxChanged(this, 'expiryDays')" checked
		               aria-label="Enable Time Limit">
		      </div>
		    </div>
		    <div class="input-group upload-option-input-group">
		      <input type="number" class="form-control admin-input" value="14"
		             name="expiryDays" id="expiryDays" min="1" max="100000"
		             style="text-align: right;" data-allow-regular-paste>
		      <span class="input-group-text upload-option-suffix">Days</span>
		    </div>
		  </div>

		  <div class="upload-option-card">
		    <div class="upload-option-header">
		      <div class="d-flex align-items-center gap-2">
		        <i class="bi bi-arrow-down-circle upload-option-icon"></i>
		        <span class="upload-option-label">Download Limit</span>
		      </div>
		      <div class="form-check form-switch mb-0">
		        <input class="form-check-input upload-option-toggle" type="checkbox" role="switch"
		               name="enableDownloadLimit" id="enableDownloadLimit"
		               onchange="checkBoxChanged(this, 'allowedDownloads')"
		               aria-label="Enable Download Limit">
		      </div>
		    </div>
		    <div class="input-group upload-option-input-group">
		      <input type="number" class="form-control admin-input" value="1"
		             name="allowedDownloads" id="allowedDownloads" min="1"
		             style="text-align: right;" data-allow-regular-paste disabled>
		      <span class="input-group-text upload-option-suffix">Downloads</span>
		    </div>
		  </div>

		  <div class="upload-option-card">
		    <div class="upload-option-header">
		      <div class="d-flex align-items-center gap-2">
		        <i class="bi bi-key upload-option-icon"></i>
		        <span class="upload-option-label">Password</span>
		      </div>
		      <div class="form-check form-switch mb-0">
		        <input class="form-check-input upload-option-toggle" type="checkbox" role="switch"
		               name="enablePassword" id="enablePassword"
		               onchange="checkBoxChanged(this, 'password')"
		               aria-label="Enable Password Protection">
		      </div>
		    </div>
		    <input class="form-control admin-input upload-option-input-group" value=""
		           name="password" id="password" placeholder="No password" disabled
		           data-allow-regular-paste>
		  </div>

		</div>
		</div>
<div id="errordiv" class="alert alert-danger" style="display:none">
  <span id="errormessage" ></span>
</div>
		<br><br>
		<p class="small text-muted mt-2 mb-1">Files you upload now appear below. Everything you have shared is in <a href="./files">Files</a>.</p>
		{{ template "file_browser" .Browser }}
		{{ template "media_viewer" }}
		{{ template "media_help_sheet" }}
		  </div>
		</div>
	    </div>
   	 </div>
	
	{{ template "admin_modal_edit" }}
	{{ template "file_browser_dialogs" .ServerUrl }}
	

	<div id="toastnotification" class="toastnotification" data-default="URL copied to clipboard">Toast Text</div>
	<div id="toastnotificationUndo" class="toastnotification">
	  File deleted: <span id="toastFilename"></span>
  	   <span id="toastUndoButton" class="toast-undo" onclick="handleUndo(this)">Restore</span>
	</div>
	<div id="toastDeprecation" class="toastnotification toastdeprecation">
	  Warning! This server is using a deprecated feature. Detailed information can be found in the system logs.
	</div>
	<div id="qroverlay">
	  <div id="qrcode"></div>
	</div>

	<script src="./js/min/admin.min.{{ template "js_admin_version"}}.js"></script>
	<script>
	
	initDropzone();

	setUploadDropzoneOptions({{ .MaxFileSize }}, {{ .ChunkSize }}, {{ .MaxParallelUploads }});
	
	registerChangeHandler();
	setUploadDefaults();
	setAutoLinkDefault();
	initUploadTarget();
	
{{ if .ShowDeprecationNotice }}
	showDeprecationNotice();
{{ end }}
	
	</script>
        <script src="./js/min/uuid.min.js"></script>

{{ if .EndToEndEncryption }}
        <script src="./js/min/wasm_exec.min.js"></script>
	<script src="./js/min/end2end_admin.min.{{ template "js_e2eversion"}}.js"></script>
	<script>
	{{ if .IncludeFilename }} 
		const IncludeFilename = true;
	{{ else }}
		const IncludeFilename = false;
	{{ end }}
		isE2EEnabled = true;
	
		Blob.prototype.arrayBuffer ??= function() {
		    return new Response(this).arrayBuffer()
		}
		
		checkIfE2EKeyIsSet();
	</script>
{{ end }}
        
        
{{ template "pagename" "FileRequest"}}
{{ template "customjs" .}}


{{ template "footer" true}}
{{ end }}



{{ define "admin_modal_edit" }}

	<div class="modal fade" id="modaledit" tabindex="-1" aria-labelledby="m_filenamelabel" aria-hidden="true">
	  <div class="modal-dialog  modal-lg gokapi-dialog">
	    <div class="modal-content gokapi-dialog">
	      <div class="modal-header">
		<h1 class="modal-title fs-5" id="m_filenamelabel">Filename</h1>
	      </div>
	      <div class="modal-body">
		<div class="input-group mb-3">
		  <div class="input-group-text"><i class="bi bi-tag" aria-hidden="true"></i></div>
		  <span class="input-group-text modal-samesize-input-edit" id="edit_name">Name</span>
		  <input type="text" id="mi_edit_name" class="form-control" maxlength="400" aria-label="Name" aria-describedby="edit_name" data-allow-regular-paste>
		</div>
		<div class="input-group mb-3">
		  <div class="input-group-text">
      			<input type="checkbox" id="mc_download"  checked aria-label="Limit downloads" title="Limit downloads"  data-toggle-target="mi_edit_down" onchange="handleEditCheckboxChange(this)">
   		 </div>
		  <span class="input-group-text modal-samesize-input-edit" id="edit_down">Limit Downloads</span>
		  <input type="number" min="1" id="mi_edit_down" class="form-control" aria-label="Downloads Remaining" aria-describedby="edit_down" data-allow-regular-paste>
		</div>
		<div class="input-group mb-3">
		  <div class="input-group-text">
      			<input id="mc_expiry" type="checkbox" checked aria-label="Expire files" title="Expire files"  data-toggle-target="mi_edit_expiry" data-timestamp="" onchange="handleEditCheckboxChange(this)" >
   		 </div>
		  <span class="input-group-text modal-samesize-input-edit" id="edit_expdate">Expiry</span>
		  <input type="text" id="mi_edit_expiry" class="form-control" aria-label="Expiry" aria-describedby="edit_expdate"  data-allow-regular-paste>
		</div>
		<div class="input-group mb-3">
		  <div class="input-group-text">
      			<input type="checkbox" id="mc_password" aria-label="Require password" title="Require password" data-toggle-target="mi_edit_pw" onchange="handleEditCheckboxChange(this)">
   		 </div>
		  <span class="input-group-text modal-samesize-input-edit" id="edit_pw">Password</span>
		  <input type="text" id="mi_edit_pw" class="form-control" aria-label="Password" disabled onclick="selectTextForPw(this)" aria-describedby="edit_pw"  data-allow-regular-paste>
		</div>
		
	      <div class="input-group mb-3" id="replaceGroup">
		  <div class="input-group-text">
		    <input type="checkbox" id="mc_replace" aria-label="Replace file content" title="Replace file content" data-toggle-target="mi_edit_replace" onchange="handleEditCheckboxChange(this)">
		  </div>
		  <span class="input-group-text modal-samesize-input-edit" id="edit_replace">Replace Content</span>
		  <select id="mi_edit_replace" class="form-select" aria-label="Replace File Content" disabled>
		  </select>
		</div>
	      </div>
	      <div class="modal-footer">
		<button type="button" class="btn btn-outline-light"  aria-label="Close" data-bs-dismiss="modal">Close</button>
		<button type="button" class="btn btn-primary" data-fileid="" id="mb_save" onclick="editFile();">Save changes</button>
	      </div>
	    </div>
	  </div>
	</div>

{{ end }}
