{{define "collection"}}{{template "header" .}}

<div class="container-fluid download-wrapper p-4">
    <div class="file-card card{{ if not .IsPasswordView }} fgs-collection-wide{{ end }}">
{{ if .IsPasswordView }}
        <div class="card-body p-5 text-center">
            <h3 class="card-title mb-3">{{ .Collection.Name }}</h3>
            <p class="text-muted">This collection is password protected.</p>
            {{ if .IsFailedLogin }}
            <div class="alert alert-danger py-2">Incorrect password</div>
            {{ end }}
            <form method="post" action="./c?id={{ .Collection.Id }}" class="mt-3">
                <input type="password" name="password" class="form-control mb-3"
                       placeholder="Password" autofocus required>
                <button type="submit" class="btn btn-light w-100">Unlock</button>
            </form>
        </div>
{{ else }}
        <div class="card-body p-4">

            {{/* Hidden until media.js finds a same-origin referrer other than this page (FGS.initBackButton); the margin is on the button so a hidden one leaves no gap */}}
            <button type="button" class="btn btn-sm btn-outline-light d-none mb-2" data-fgs-back>
                <i class="bi bi-arrow-left"></i> Back
            </button>

            <div class="text-center mb-4">
                <h3 class="card-title mb-1">{{ .Collection.Name }}</h3>
                <p class="text-muted mb-0">
                    {{/* The file count is the list's own ("Files: n"), which follows what is shown */}}
                    {{ .TotalSize }}{{ if not .NeverExpires }} &middot; available until {{ .ExpiryString }}{{ end }}
                </p>
            </div>

            {{ template "file_browser" .Browser }}

            {{ template "media_download_buttons" .Buttons }}
            {{ template "media_help_sheet" }}
            {{ template "media_viewer" }}

            <script>
            // Download all, Save to Photos and the zip link act on every file in the list;
            // the selection bar inside it acts on the selected ones
            FGS.initDownloadButtons(document.querySelector("[data-fgs-downloads]"));
            FGS.initBackButton(document.querySelector("[data-fgs-back]"));
            </script>

        </div>
{{ end }}
    </div>
</div>

{{ template "pagename" "PublicCollection"}}
{{ template "customjs" .}}

{{template "footer"}}
{{end}}
