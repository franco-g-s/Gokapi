{{define "collection"}}{{template "header" .}}

<div class="container-fluid download-wrapper p-4">
    <div class="file-card card">
{{ if .IsPasswordView }}
        <div class="card-body p-5 text-center">
            <h3 class="card-title mb-3">{{ .Collection.Name }}</h3>
            <p class="text-muted">This collection is password protected.</p>
            {{ if .IsFailedLogin }}
            <div class="alert alert-danger py-2">Incorrect password</div>
            {{ end }}
            <form method="post" action="./c?id={{ .Collection.Id }}" class="mt-3">
                <input type="password" name="password" class="form-control mb-3"
                       placeholder="Password" autofocus required>
                <button type="submit" class="btn btn-light w-100">Unlock</button>
            </form>
        </div>
{{ else }}
        <div class="card-body p-4">

            <div class="text-center mb-4">
                <h3 class="card-title mb-1">{{ .Collection.Name }}</h3>
                <p class="text-muted mb-0">
                    {{ .FileCount }} file{{ if ne .FileCount 1 }}s{{ end }} &middot; {{ .TotalSize }}
                    {{ if not .NeverExpires }} &middot; available until {{ .ExpiryString }}{{ end }}
                </p>
            </div>

            <div class="table-responsive">
                <table class="table table-dark align-middle" id="collectiontable">
                    <thead>
                        <tr>
                            <th scope="col">Filename</th>
                            <th scope="col">Size</th>
                            <th scope="col" class="text-end">Download</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{ range .Collection.Files }}
                        <tr>
                            <td class="collection-filename">{{ .Name }}</td>
                            <td>{{ .Size }}</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-light"
                                   href="./cd?id={{ $.Collection.Id }}&amp;file={{ .Id }}"
                                   data-fileid="{{ .Id }}"
                                   data-filename="{{ .Name }}">
                                    <i class="bi bi-download"></i>
                                </a>
                            </td>
                        </tr>
                        {{ end }}
                    </tbody>
                </table>
            </div>

            {{ template "media_download_buttons" .Buttons }}
            {{ template "media_help_sheet" }}

        </div>
{{ end }}
    </div>
</div>

<script>
// Download all: each file in turn, via the shared FGS.downloadSequentially
(function () {
    var button = document.getElementById("downloadAllButton");
    var status = document.getElementById("downloadAllStatus");
    if (!button || !status) return;
    var links = Array.prototype.slice.call(
        document.querySelectorAll("#collectiontable a[data-fileid]"));
    if (!links.length) { button.style.display = "none"; return; }

    button.addEventListener("click", function () {
        FGS.downloadSequentially(links.map(function (source) {
            return { url: source.getAttribute("href"), name: source.getAttribute("data-filename") || "" };
        }), { button: button, status: status });
    });
})();
</script>

<script>FGS.initDownloadButtons(document.querySelector("[data-fgs-downloads]"));</script>

{{ template "pagename" "PublicCollection"}}
{{ template "customjs" .}}

{{template "footer"}}
{{end}}
