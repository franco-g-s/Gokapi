<script>
document.querySelectorAll(".collection-copy").forEach(function (button) {
    button.addEventListener("click", function () {
        navigator.clipboard.writeText(button.getAttribute("data-url")).then(function () {
            var original = button.innerHTML;
            button.textContent = "Copied";
            window.setTimeout(function () { button.innerHTML = original; }, 1500);
        });
    });
});
// An expired session answers with the login page rather than JSON; say so
// instead of failing on the parse. Never rejects: callers show ErrorMessage.
function postCollection(url, payload) {
    return fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify(payload)
    }).then(function (r) {
        return r.text().then(function (text) {
            try {
                return JSON.parse(text);
            } catch (ignored) {
                return { Result: "error", ErrorMessage: r.redirected || text.trim().charAt(0) === "<" ?
                    "Your session expired — reload the page" : "Unexpected answer from the server" };
            }
        });
    }, function (e) { return { Result: "error", ErrorMessage: String(e) }; });
}

// The member list was built while its row was hidden: measure it now. The
// List's table needs its column widths worked out, the Board its masonry.
function laidOutWhenShown(row) {
    var root = row.querySelector("[data-fgs-browser]");
    if (!root || !window.FGS || !FGS.initFileBrowser) return;
    var browser = FGS.initFileBrowser(root);
    var table = root.querySelector("table.fgs-table");
    if (window.jQuery && jQuery.fn.dataTable && table && jQuery.fn.dataTable.isDataTable(table)) {
        jQuery(table).DataTable().columns.adjust();
    }
    if (browser) browser.relayout();
}

document.querySelectorAll(".collection-files").forEach(function (button) {
    button.addEventListener("click", function () {
        var row = document.getElementById("files-" + button.getAttribute("data-id"));
        if (!row) return;
        row.style.display = row.style.display === "none" ? "" : "none";
        if (row.style.display !== "none") laidOutWhenShown(row);
    });
});

document.querySelectorAll(".collection-rename").forEach(function (button) {
    button.addEventListener("click", function () {
        var id = button.getAttribute("data-id");
        var name = window.prompt("New name:", button.getAttribute("data-name"));
        if (name === null || name.trim() === "") return;
        postCollection("./collections/modify", { id: id, name: name.trim() })
            .then(function (data) {
                if (data.Result !== "OK") {
                    window.alert("Could not rename: " + (data.ErrorMessage || "unknown error"));
                    return;
                }
                window.location.reload();
            });
    });
});

document.querySelectorAll(".collection-password").forEach(function (button) {
    button.addEventListener("click", function () {
        var has = button.getAttribute("data-haspassword") === "true";
        // Passwords are stored hashed and cannot be read back, so this always
        // sets a new one rather than showing the current one.
        var message = has
            ? "Set a NEW password for \"" + button.getAttribute("data-name") + "\".\n\n" +
              "The current one cannot be shown - it is stored hashed.\n" +
              "Leave blank to remove password protection."
            : "Set a password for \"" + button.getAttribute("data-name") + "\".\n\n" +
              "Leave blank for no password.";
        var value = window.prompt(message, "");
        if (value === null) return;
        button.disabled = true;
        postCollection("./collections/modify",
                       { id: button.getAttribute("data-id"), password: value.trim() })
            .then(function (data) {
                if (data.Result !== "OK") {
                    window.alert("Could not update: " + (data.ErrorMessage || "unknown error"));
                    button.disabled = false;
                    return;
                }
                window.location.reload();
            });
    });
});

// The summary row follows the member list: "Remove from collection" reports
// the collection's figures (admin_ui_filebrowser.js), so no reload is needed.
document.addEventListener("fgs:collection-changed", function (e) {
    var d = e.detail || {};
    var row = document.getElementById("collection-" + d.collectionId);
    if (!row) return;
    var set = function (sel, text) { var c = row.querySelector(sel); if (c && text !== undefined) c.textContent = text; };
    set("[data-col-count]", d.fileCount === undefined ? undefined : String(d.fileCount));
    set("[data-col-size]", d.totalSize);
    if (d.neverExpires !== undefined) set("[data-col-expiry]", d.neverExpires ? "Unlimited" : d.expiry);
});

// --- file picker: shared by "new collection" and "add files" ---------------
(function () {
    var modalEl = document.getElementById("filePickerModal");
    if (!modalEl) return;
    var modal = new bootstrap.Modal(modalEl);
    var title = document.getElementById("filePickerTitle");
    var confirm = document.getElementById("filePickerConfirm");
    var counter = document.getElementById("filePickerCount");
    var filter = document.getElementById("filePickerFilter");
    var boxes = Array.prototype.slice.call(document.querySelectorAll(".file-picker-check"));
    var mode = null;          // "create" | "add"
    var targetId = null;

    // Disabled boxes are files already in the collection: shown ticked so it is
    // obvious why they cannot be picked, but never counted or resent.
    function selectedIds() {
        return boxes
            .filter(function (b) { return b.checked && !b.disabled; })
            .map(function (b) { return b.value; });
    }

    // Existing members are read from the collection's file list already on the
    // page, so this needs no extra request.
    function existingMemberIds(collectionId) {
        var ids = [];
        var root = document.getElementById("col-" + collectionId);
        if (!root) return ids;
        root.querySelectorAll("[data-fgs-grid] .fgs-tile").forEach(function (tile) {
            ids.push(tile.getAttribute("data-id"));
        });
        return ids;
    }
    function refresh() {
        var n = selectedIds().length;
        confirm.disabled = n === 0;
        counter.textContent = n === 0 ? "" : n + " selected";
    }
    boxes.forEach(function (b) { b.addEventListener("change", refresh); });

    if (filter) {
        filter.addEventListener("input", function () {
            var needle = filter.value.toLowerCase();
            document.querySelectorAll(".file-picker-list li").forEach(function (li) {
                var name = (li.getAttribute("data-name") || "").toLowerCase();
                li.style.display = name.indexOf(needle) === -1 ? "none" : "";
            });
        });
    }

    function open(newMode, id, label) {
        mode = newMode;
        targetId = id;
        var already = newMode === "add" ? existingMemberIds(id) : [];
        boxes.forEach(function (b) {
            var isMember = already.indexOf(b.value) !== -1;
            b.checked = isMember;
            b.disabled = isMember;
            var row = b.closest("li");
            if (row) {
                row.classList.toggle("is-member", isMember);
                var note = row.querySelector(".picker-already");
                if (isMember && !note) {
                    var span = document.createElement("span");
                    span.className = "picker-already";
                    span.textContent = "already added";
                    // inserted before the size so every size stays in one column
                    row.querySelector("label").insertBefore(span, row.querySelector(".picker-size"));
                } else if (!isMember && note) {
                    note.remove();
                }
            }
        });
        if (filter) { filter.value = ""; filter.dispatchEvent(new Event("input")); }
        title.textContent = newMode === "create" ? "New collection" : "Add files to " + label;
        var meta = document.getElementById("filePickerMeta");
        if (meta) meta.style.display = newMode === "create" ? "" : "none";
        refresh();
        modal.show();
    }

    // Word-based passphrase, easy to read out or type
    var WORDS = ("amber anchor arrow autumn beacon bishop bottle branch bridge bronze " +
        "cactus candle canvas castle cedar cherry cobalt comet copper coral cotton " +
        "crimson crystal delta desert dragon ember falcon forest garnet ginger glacier " +
        "granite harbor harvest hazel indigo island ivory jasmine jungle juniper lagoon " +
        "lantern laurel lemon lilac linen lotus maple marble meadow meteor mirror mosaic " +
        "nectar nickel nomad nutmeg oasis olive onyx opal orbit orchard pebble pepper " +
        "pigeon pillar planet poplar prairie prism quartz quiver raven ribbon river " +
        "rocket saffron sailor salmon sapphire scarlet shadow silver socket solar spruce " +
        "stellar summit sunset thistle thunder timber topaz tulip tundra valley velvet " +
        "village violet walnut willow winter zephyr").split(" ");
    function randomInt(max) {
        if (window.crypto && window.crypto.getRandomValues) {
            var a = new Uint32Array(1);
            var limit = Math.floor(4294967296 / max) * max;
            do { window.crypto.getRandomValues(a); } while (a[0] >= limit);
            return a[0] % max;
        }
        return Math.floor(Math.random() * max);
    }
    var suggestButton = document.getElementById("filePickerSuggest");
    if (suggestButton) {
        suggestButton.addEventListener("click", function () {
            var parts = [];
            for (var i = 0; i < 3; i++) parts.push(WORDS[randomInt(WORDS.length)]);
            document.getElementById("filePickerPassword").value =
                parts.join("-") + "-" + (randomInt(90) + 10);
        });
    }

    // Puts files just added to a collection into its list, and the summary row
    function showAdded(collectionId, fileIds, data) {
        var root = document.getElementById("col-" + collectionId);
        // The row follows whether or not the list can be updated in place
        document.dispatchEvent(new CustomEvent("fgs:collection-changed", { detail: {
            collectionId: collectionId, fileCount: data.FileCount, totalSize: data.TotalSize,
            expiry: data.Expiry, neverExpires: data.NeverExpires } }));
        var browser = root && window.FGS && FGS.initFileBrowser(root);
        if (!browser || typeof apiFilesListById !== "function") return Promise.reject(new Error("no list"));
        var one = function (id) {
            if (browser.tile(id)) return Promise.resolve();
            return apiFilesListById(id).then(function (file) {
                return fetch("./files/previewinfo?id=" + encodeURIComponent(id), { credentials: "same-origin" })
                    .then(function (r) { return r.ok ? r.json() : {}; }, function () { return {}; })
                    .then(function (preview) { browser.addItem(file, preview); });
            }, function (error) {
                // 404: gone since the picker was built, which the server
                // skipped too. Anything else is a real failure.
                if (String(error && error.message).indexOf("404") === -1) throw error;
            });
        };
        return Promise.all(fileIds.map(one));
    }

    // "Add to collection…" from a list's menu or selection bar, into a
    // collection listed here: its list gets the files too. No reload (the
    // dialog is showing the new link); if the list cannot be updated, the
    // files show on the next load.
    document.addEventListener("fgs:collection-members-added", function (e) {
        var d = e.detail || {};
        showAdded(d.collectionId, d.ids || [], d.data || {}).catch(function (error) {
            console.warn("Could not add the files to the collection's list:", error);
        });
    });

    var newButton = document.getElementById("newCollectionButton");
    if (newButton) {
        newButton.addEventListener("click", function () { open("create", null, ""); });
    }
    document.querySelectorAll(".collection-addfiles").forEach(function (button) {
        button.addEventListener("click", function () {
            open("add", button.getAttribute("data-id"), button.getAttribute("data-name"));
        });
    });

    confirm.addEventListener("click", function () {
        var ids = selectedIds();
        if (!ids.length) return;
        confirm.disabled = true;

        if (mode === "add") {
            postCollection("./collections/modify", { id: targetId, addFileIds: ids })
                .then(function (data) {
                    if (data.Result !== "OK") {
                        window.alert("Could not add: " + (data.ErrorMessage || "unknown error"));
                        confirm.disabled = false;
                        return;
                    }
                    // In place: each added file's details and preview go into
                    // that collection's list. If any of that fails the page
                    // reloads, which shows the same thing from the server.
                    showAdded(targetId, ids, data).then(function () {
                        modal.hide();
                    }, function () {
                        window.location.reload();
                    });
                });
            return;
        }

        var nameField = document.getElementById("filePickerName");
        var pwField = document.getElementById("filePickerPassword");
        var name = (nameField.value || "").trim() || "Shared files";
        var password = (pwField.value || "").trim();
        postCollection("./collections/create",
                       { name: name, fileIds: ids, password: password })
            .then(function (data) {
                if (data.Result !== "OK") {
                    window.alert("Could not create: " + (data.ErrorMessage || "unknown error"));
                    confirm.disabled = false;
                    return;
                }
                window.location.reload();
            });
    });
})();

document.querySelectorAll(".collection-delete").forEach(function (button) {
    button.addEventListener("click", function () {
        var id = button.getAttribute("data-id");
        if (!window.confirm("Delete the collection \"" + button.getAttribute("data-name") +
                            "\"?\n\nThe files themselves are kept.")) {
            return;
        }
        button.disabled = true;
        fetch("./collections/delete?id=" + encodeURIComponent(id), {
            method: "POST", credentials: "same-origin"
        }).then(function (r) { return r.json(); }).then(function (data) {
            if (data.Result !== "OK") {
                window.alert("Could not delete: " + (data.ErrorMessage || "unknown error"));
                button.disabled = false;
                return;
            }
            var row = document.getElementById("collection-" + id);
            if (row) row.remove();
        }).catch(function (e) {
            window.alert("Could not delete: " + e);
            button.disabled = false;
        });
    });
});
</script>

