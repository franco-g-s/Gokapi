{{/* "Turn into a group", shared by the Collections tab and the owner bar of a
     collection's own page; both load collection_togroup.js, which runs it */}}
{{ define "collection_togroup_modal" }}
<div class="modal fade" id="togroup-modal" tabindex="-1" aria-labelledby="togroup-title" aria-hidden="true">
  <div class="modal-dialog gokapi-dialog">
    <div class="modal-content gokapi-dialog text-start">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="togroup-title">Turn into a group</h1>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p id="togroup-what"></p>
        <p class="text-muted small">
          The collection&rsquo;s password does not carry over: people join the group by signing in.
        </p>
        <div class="mb-3 d-none" id="togroup-viewers">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="togroup-add-viewers" checked>
            <label class="form-check-label" for="togroup-add-viewers">Add the people who opened this link while signed in</label>
          </div>
          <p class="text-muted small ms-4 mb-0" id="togroup-viewer-names"></p>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="togroup-days" id="togroup-days-30" value="30">
          <label class="form-check-label" for="togroup-days-30">30 days</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="togroup-days" id="togroup-days-60" value="60" checked>
          <label class="form-check-label" for="togroup-days-60">60 days (suggested)</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="togroup-days" id="togroup-days-90" value="90">
          <label class="form-check-label" for="togroup-days-90">90 days</label>
        </div>
        <div class="form-check">
          <input class="form-check-input" type="radio" name="togroup-days" id="togroup-days-0" value="0">
          <label class="form-check-label" for="togroup-days-0">Never</label>
        </div>
        <fieldset class="mt-3">
          <legend class="fs-6 mb-1">Old link</legend>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="togroup-link" id="togroup-link-invite" value="invite" checked>
            <label class="form-check-label" for="togroup-link-invite">Show the photos and invite to join</label>
          </div>
          <div class="form-check">
            <input class="form-check-input" type="radio" name="togroup-link" id="togroup-link-require" value="require">
            <label class="form-check-label" for="togroup-link-require">Require signing in and joining</label>
          </div>
        </fieldset>
        <div id="togroup-status" aria-live="polite"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-light" id="togroup-confirm">Turn into a group</button>
      </div>
    </div>
  </div>
</div>
{{ end }}
