{{ define "users" }}
{{ template "header" . }}
<div class="row">
    <div class="col">
        <div id="container" class="card" style="width: 80%">
    <div class="card-body">
		<div class="container">
		  <div class="row mb-4">
		    <div class="col">
		    </div>
		    <div class="col text-center">
		      <h3 class="card-title mb-0">Users</h3>
		    </div>
		    <div class="col text-end">
		      <button id="add-user-btn" class="btn btn-outline-light" onclick="showAddUserModal()">
                    <i class="bi bi-plus-circle-fill"></i>
                </button>
		    </div>
		  </div>
		</div>
                <div class="table-responsive">
                    <table class="table table-dark">
                        <thead>
                            <tr>
                                <th scope="col">User</th>
                                <th scope="col">User type</th>
                                <th scope="col">Last online</th>
                                <th scope="col">Uploads</th>
                                <th scope="col">Size</th>
                                <th scope="col">Groups</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="usertable">
{{ range .Users }}
                            <tr id="row-{{ .User.Id }}">
                                <td class="fgs-user-name"><span class="fgs-user-shown">{{ .ShownName }}</span>{{ if and $.ActiveUser.IsAdmin (ne $.ActiveUser.Id 0) (not .User.IsAdmin) (ne .User.Id $.ActiveUser.Id) }} <button type="button" class="btn btn-outline-light btn-sm fgs-viewas-btn" data-fgs-viewas-user="{{ .User.Id }}">View as…</button>{{ end }}{{ if ne .ShownName .User.Name }}<small class="text-muted d-block fgs-user-email">{{ .User.Name }}</small>{{ end }}</td>
                                <td id="userlevel_{{ .User.Id }}">{{ .User.GetReadableUserLevel }}</td>
                                <td><span id="cell-lastonline-{{ .User.Id }}"></span></td>
                                <script>insertLastOnlineDate({{ .User.LastOnline }}, "cell-lastonline-{{ .User.Id }}");</script>
                                <td><span class="user-uploadcount">{{ .UploadCount }}</span></td>
                                <td>{{ .TotalSize }}</td>
                                <td>{{ if .Groups }}{{ range $i, $name := .Groups }}{{ if $i }} {{ end }}<span class="badge text-bg-secondary">{{ $name }}</span>{{ end }}{{ else }}—{{ end }}</td>
                                <td class="text-nowrap">
                                <div class="dropdown d-inline-block prevent-select">
                                  <button type="button" class="btn btn-outline-light btn-sm dropdown-toggle" data-bs-toggle="dropdown" data-bs-auto-close="outside" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false">Permissions</button>
                                  <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end fgs-perm-menu">
                                    <li><button type="button" class="dropdown-item fgs-perm-item" onclick='changeUserPermission("{{ .User.Id }}","PERM_GUEST_UPLOAD", "perm_guest_upload_{{ .User.Id }}");'><i id="perm_guest_upload_{{ .User.Id }}" class="bi bi-box-arrow-in-down {{if not .User.HasPermissionCreateFileRequests}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionCreateFileRequests) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}"></i> Create file requests</button></li>
                                    <li><button type="button" class="dropdown-item fgs-perm-item" onclick='changeUserPermission("{{ .User.Id }}","PERM_REPLACE", "perm_replace_{{ .User.Id }}");'><i id="perm_replace_{{ .User.Id }}" class="bi bi-recycle {{if not .User.HasPermissionReplace}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionReplace) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}"></i> Replace own uploads</button></li>
                                    <li><button type="button" class="dropdown-item fgs-perm-item" onclick='changeUserPermission("{{ .User.Id }}","PERM_LIST", "perm_list_{{ .User.Id }}");'><i id="perm_list_{{ .User.Id }}" class="bi bi-eye {{if not .User.HasPermissionListOtherUploads}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionListOtherUploads) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}"></i> List other uploads</button></li>
                                    <li><button type="button" class="dropdown-item fgs-perm-item" onclick='changeUserPermission("{{ .User.Id }}","PERM_EDIT", "perm_edit_{{ .User.Id }}");'><i id="perm_edit_{{ .User.Id }}" class="bi bi-pencil {{if not .User.HasPermissionEditOtherUploads}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionEditOtherUploads) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}"></i> Edit other uploads</button></li>
                                    <li><button type="button" class="dropdown-item fgs-perm-item" onclick='changeUserPermission("{{ .User.Id }}","PERM_DELETE", "perm_delete_{{ .User.Id }}");'><i id="perm_delete_{{ .User.Id }}" class="bi bi-trash3 {{if not .User.HasPermissionDeleteOtherUploads}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionDeleteOtherUploads) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}"></i> Delete other uploads</button></li>
                                    <li><button type="button" class="dropdown-item fgs-perm-item" onclick='changeUserPermission("{{ .User.Id }}","PERM_REPLACE_OTHER", "perm_replace_other_{{ .User.Id }}");'><i id="perm_replace_other_{{ .User.Id }}" class="bi bi-arrow-left-right {{if not .User.HasPermissionReplaceOtherUploads}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionReplaceOtherUploads) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}"></i> Replace other uploads</button></li>
                                    <li><button type="button" class="dropdown-item fgs-perm-item" onclick='changeUserPermission("{{ .User.Id }}","PERM_LOGS", "perm_logs_{{ .User.Id }}");'><i id="perm_logs_{{ .User.Id }}" class="bi bi-card-list {{if not .User.HasPermissionManageLogs}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionManageLogs) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}"></i> Manage system logs</button></li>
                                    <li><button type="button" class="dropdown-item fgs-perm-item" onclick='changeUserPermission("{{ .User.Id }}","PERM_USERS", "perm_users_{{ .User.Id }}");'><i id="perm_users_{{ .User.Id }}" class="bi bi-people {{if not .User.HasPermissionManageUsers}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionManageUsers) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}"></i> Manage users</button></li>
                                    <li><button type="button" class="dropdown-item fgs-perm-item" onclick='changeUserPermission("{{ .User.Id }}","PERM_API", "perm_api_{{ .User.Id }}");'><i id="perm_api_{{ .User.Id }}" class="bi bi-sliders2 {{if not .User.HasPermissionManageApi}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionManageApi) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}"></i> Manage all API keys</button></li>
                                  </ul>
                                </div>
                                <div class="dropdown d-inline-block">
                                  <button type="button" class="btn btn-outline-light btn-sm" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" aria-label="Actions" title="Actions">⋯</button>
                                  <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end fgs-user-actions">
                                    {{if $.IsInternalAuth}}
                                    <li><button id="pwchange-{{ .User.Id }}" type="button" class="dropdown-item" {{if or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id)}}disabled{{end}} onclick="showResetPwModal('{{ .User.Id }}', '{{ .User.Name }}')"><i class="bi bi-key-fill"></i> Reset password</button></li>
                                    {{end}}
                                    {{if not .User.IsAdmin}}
                                    <li><button id="changeRank_{{ .User.Id }}" type="button" class="dropdown-item" onclick="changeRank({{ .User.Id }}, 'ADMIN', 'changeRank_{{ .User.Id }}')" {{ if or (eq .User.Id $.ActiveUser.Id) (not $.ActiveUser.IsAdmin)}}disabled{{end}}><i class="bi bi-chevron-double-up"></i> Change user type to Admin</button></li>
                                    {{ else }}
                                    <li><button id="changeRank_{{ .User.Id }}" type="button" class="dropdown-item" onclick="changeRank({{ .User.Id }}, 'USER', 'changeRank_{{ .User.Id }}')" {{if or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id)}}disabled{{end}}><i class="bi bi-chevron-double-down"></i> Change user type to User</button></li>
                                    {{ end }}
                                    {{if and $.ActiveUser.IsAdmin (not .User.IsAdmin) (ne .User.Id $.ActiveUser.Id)}}
                                    <li><button type="button" class="dropdown-item text-danger fgs-block-user" data-fgs-block-user="{{ .User.Name }}"><i class="bi bi-slash-circle"></i> Block this person</button></li>
                                    {{end}}
                                    <li><hr class="dropdown-divider"></li>
                                    <li><button id="delete-{{ .User.Id }}" type="button" class="dropdown-item text-danger" {{if or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id)}}disabled{{end}} onclick="showDeleteUserModal('{{ .User.Id }}', '{{ .User.Name }}')"><i class="bi bi-trash3"></i> Delete</button></li>
                                  </ul>
                                </div>
                                </td>
                            </tr>
{{ end }}
                        </tbody>
                    </table>
                </div>
                {{if $.ActiveUser.IsAdmin}}
                <div id="blocked-card" class="mt-4 text-start">
                    <h5>Blocked</h5>
                    <form id="blocked-form" class="d-flex gap-2 mb-3" onsubmit="addBlockedEntry(); return false;">
                        <input type="text" id="blocked-input" class="form-control" placeholder="name@example.com or @example.com" autocomplete="off" required>
                        <button type="submit" class="btn btn-outline-light">Block</button>
                    </form>
                    <ul id="blocked-list" class="list-group list-group-flush">
{{ range .Blocked }}
                        <li class="list-group-item bg-transparent text-light d-flex justify-content-between align-items-center" data-fgs-blocked="{{ .Entry }}">
                            <span class="fgs-blocked-entry">{{ .Entry }}</span>
                            <button type="button" class="btn btn-outline-light btn-sm fgs-unblock" data-fgs-unblock="{{ .Entry }}">Unblock</button>
                        </li>
{{ else }}
                        <li class="list-group-item bg-transparent text-muted fgs-blocked-none">Nobody is blocked.</li>
{{ end }}
                    </ul>
                </div>
                {{end}}
            </div>
        </div>
	<div id="toastnotification" class="toastnotification" data-default="Invalid notification">Toast Text</div>
	
	<!-- Modal for deletion confirmation -->
	<div class="modal" tabindex="-1" id="deleteModal">
	  <div class="modal-dialog gokapi-dialog">
	    <div class="modal-content gokapi-dialog">
	      <div class="modal-header">
		<h5 class="modal-title">Delete User</h5>
	      </div>
	      <div class="modal-body">
		<p>Are you sure you want to delete user <span id="deleteModalBody" class="fw-bold"></span>?
		This action cannot be undone.</p>
		<div class="form-check form-check-inline">
		  <input class="form-check-input" type="checkbox"  id="checkboxDelete" value="">
		  <label class="form-check-label" for="checkboxDelete">
		    Permanently delete all files uploaded by this user.
		  </label>
		</div>
		</div>
	      <div class="modal-footer">
		<button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
		<button type="button" id="buttonDelete" class="btn btn-danger">Delete User</button>
	      </div>
	    </div>
	  </div>
	</div>
	
	
	
	<!-- Bootstrap Modal for Adding a New User -->
	<div class="modal fade" id="newUserModal" tabindex="-1" aria-labelledby="newUserModalLabel" aria-hidden="true">
	  <div class="modal-dialog gokapi-dialog">
	    <div class="modal-content gokapi-dialog">
	      <div class="modal-header">
		<h5 class="modal-title" id="newUserModalLabel">Create New User</h5>
	      </div>
	      <div class="modal-body">
		<form id="newUserForm">
		  <div class="mb-3">
		  <div class="text-start">
		    <label for="e_userName" class="form-label">Username</label>
		    </div>
		    <input type="text" class="form-control" id="e_userName" minlength="2" placeholder="Enter a username" required>
	         </div>
		</form>
	      <div class="modal-footer">
		<button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
		<button type="submit" form="newUserForm" onclick="addNewUser();" id="mb_addUser" class="btn btn-primary">Add User</button>
	      </div>
	    </div>
	  </div>
	  </div>
	  </div>
	
	
	<!-- Modal for Reset Password -->
	<div class="modal  fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
	  <div class="modal-dialog gokapi-dialog text-start">
	    <div class="modal-content gokapi-dialog">
	      <!-- Modal Header -->
	      <div class="modal-header">
		<h5 class="modal-title" id="resetPasswordModalLabel">Reset Password</h5>
	      </div>

	      <!-- Modal Body -->
	      <div class="modal-body">
		
		<div id="formentryReset">
		<p>Choose an option to reset the password for the user <span  class="fw-bold" id="l_userpwreset"></span>:</p>

		<!-- Option 1: Force user to set a new password on next login -->
		<div class="form-check mb-3">
		  <input 
		    type="radio" 
		    id="forceNewPassword" 
		    name="resetOption" 
		    class="form-check-input" 
		    value="forceNew" 
		    checked>
		  <label for="forceNewPassword" class="form-check-label">
		    Force user to set a new password on next login
		  </label>
		</div>

		<!-- Option 2: Generate and display a random password -->
		<div class="form-check mb-3">
		  <input 
		    type="radio" 
		    id="generateRandomPassword" 
		    name="resetOption" 
		    class="form-check-input" 
		    value="generateRandom">
		  <label for="generateRandomPassword" class="form-check-label">
		    Generate a new random password (user will be forced to change it on next login)
		  </label>
		</div>
		
		
		</div>

		 <!-- Display Random Password (Inline) -->
		<div id="randomPasswordContainer" class="mt-3" style="display: none;">
		  <label class="form-label">
		    New Password: 
		    <span class="highlighted-password" id="l_returnedPw"></span> <button type="button" id="copypwclip" title="Copy Password" class="copyurl btn btn-outline-light btn-sm"><i class="bi bi-copy"></i></button>
		  </label>
		</div>
	      </div>
	      <!-- Modal Footer -->
	      <div class="modal-footer">
		<button type="button" id="cancelPasswordButton"class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
		<button type="button" id="resetPasswordButton" class="btn btn-primary">Confirm</button>
		<button type="button" style="display:none" id="closeModalResetPw" class="btn btn-primary" data-bs-dismiss="modal" >OK</button>
	      </div>
	    </div>
	  </div>
	  </div>


    </div>
</div>

<script src="./js/min/admin.min.{{ template "js_admin_version"}}.js"></script>
<script>
	var isInternalAuth = {{.IsInternalAuth}};
	var isAdmin = {{.ActiveUser.IsAdmin}};
	var userPermissions = {{.ActiveUser.Permissions}};
	var canViewAs = {{ and .ActiveUser.IsAdmin (ne .ActiveUser.Id 0) }};
</script>
<style>
	/* Users tab (R2, V5) */
	#usertable .dropdown-menu { text-align: start; }
	#usertable .fgs-viewas-btn { padding: 0 .4rem; font-size: .75rem; margin-left: .35rem; vertical-align: baseline; }
	#usertable .fgs-perm-item i { margin-right: .4rem; }
	#usertable .fgs-perm-item:has(.perm-nochange) { cursor: default; }
</style>
{{ template "pagename" "OverviewUsers"}}
{{ template "customjs" .}}
{{ template "footer" true }}
{{ end }}
